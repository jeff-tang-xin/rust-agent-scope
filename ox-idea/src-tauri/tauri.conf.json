{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OXidea",
  "version": "0.0.1",
  "identifier": "ai.l0ng.oxidea",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "OXidea",
        "width": 1440,
        "height": 900,
        "minWidth": 800,
        "minHeight": 500,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "backgroundColor": "#E9EAEE",
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: data: blob: http: https:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src ipc: http://ipc.localhost; script-src 'self' 'wasm-unsafe-eval'; worker-src 'self' blob:; frame-src http://127.0.0.1:* oxidea-plugin: http://oxidea-plugin.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "category": "DeveloperTool",
    "copyright": "Copyright © 2026 OXidea contributors",
    "license": "Apache-2.0",
    "shortDescription": "An open-source IDE inspired by IntelliJ IDEA",
    "longDescription": "OXidea is an open-source IDE inspired by IntelliJ IDEA, powered by OXidea. Not affiliated with JetBrains.",
    "macOS": {
      "entitlements": "./Entitlements.plist",
      "minimumSystemVersion": "11.0"
    }
  },
  "mainBinaryName": "oxidea",
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDFCOUU0MUFFOUY4NzZCNkQKUldSdGE0ZWZya0dlRzNnRFJUR2loUVdNZ1BmamxkNzFoaWNPUTBsRmI0cjhxZFRqQURybkMwakEK",
      "endpoints": ["https://github.com/jeff-tang-xin/rust-agent-scope/releases/download/latest.json"]
    }
  }
}
